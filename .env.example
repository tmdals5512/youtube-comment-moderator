# ── App ─────────────────────────────────────────
APP_NAME=Outlier API
DEBUG=true

# ── PostgreSQL (pgvector/pg17, Docker: outlier-db) ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=여기에_DB_비밀번호
DB_ECHO=false

# ── YouTube Data API ────────────────────────────
# 읽기 전용. 조치(숨김·차단)는 OAuth 2.0이 따로 필요하다.
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급.
# 주의: 키에 'HTTP 리퍼러' 제한을 걸면 서버에서 호출이 막힌다. 제한 없음 또는 IP 제한으로.
YOUTUBE_API_KEY=

# ── OpenAI (3차 LLM 판별) ─────────────────────
# https://platform.openai.com/api-keys 에서 발급
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# ── 개발 편의 ───────────────────────────────
# 구글 OAuth 설정 없이 로그인한 셈 치고 들어간다. localhost + DEBUG=true 에서만.
# 실서비스에서는 반드시 꺼둘 것.
DEV_LOGIN=false

# ── Google OAuth ────────────────────────────
# console.cloud.google.com > API 및 서비스 > 사용자 인증 정보
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000
