  "/api/comments/{comment_id}/similar": {
   "get": {
    "tags": [
     "review"
    ],
    "summary": "과거 유사 사례 (F_R_114)",
    "description": "뜻이 비슷한 과거 댓글과, 그때 관리자가 내린 결정을 함께 돌려준다.\n\n단어가 겹치는 댓글이 아니라 '같은 사안'을 찾는 게 목적이다 —\n\"주소 알아내서 찾아간다\"와 \"어디 사는지 알아냈음\"은 겹치는 단어가\n없지만 관리자에겐 같은 건이다.\n\n같은 채널 안에서만 찾는다. 채널(고객사)간 데이터 결합·비교 노출은\nYouTube API 정책상 금지다.",
    "operationId": "similar_api_comments__comment_id__similar_get",
    "parameters": [
     {
      "name": "comment_id",
      "in": "path",
      "required": true,
      "schema": {
       "type": "integer",
       "title": "Comment Id"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "schema": {
       "type": "integer",
       "maximum": 10,
       "minimum": 1,
       "default": 3,
       "title": "Limit"
      }
     },
     {
      "name": "only_reviewed",
      "in": "query",
      "required": false,
      "schema": {
       "type": "boolean",
       "description": "관리자가 실제로 처리한 것만 보기",
       "default": false,
       "title": "Only Reviewed"
      },
      "description": "관리자가 실제로 처리한 것만 보기"
     }
    ],
    "responses": {
     "200": {
      "description": "Successful Response",
      "content": {
       "application/json": {
        "schema": {
         "type": "array",
         "items": {
          "$ref": "#/components/schemas/SimilarCase"
         },
         "title": "Response Similar Api Comments  Comment Id  Similar Get"
        }
       }
      }
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  }
