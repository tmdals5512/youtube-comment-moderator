# deploy/.env — 서버에서만 만든다. 레포에 넣지 않는다.
# 노트북의 .env 를 바탕으로 아래만 다르다.

# DB (컨테이너 안에서 새로 만든다. 비번은 새로 정한다)
POSTGRES_PASSWORD=바꿔라
POSTGRES_DB=postgres
POSTGRES_USER=postgres

# 주소. 도메인이 있으면 https://도메인, 없으면 http://공인IP
OAUTH_REDIRECT_BASE=http://1.2.3.4
# https 가 되면 true 로 (쿠키를 https 에서만 보낸다)
SESSION_COOKIE_SECURE=false
# Caddy 가 들을 주소. 도메인이 있으면 도메인, 없으면 :80
SITE_ADDRESS=:80

# 라벨링 페이지 팀 비밀번호. 주소를 아는 사람 누구나 실제 댓글을 보는 걸 막는다.
LABEL_KEY=영문숫자로-바꿔라

# 운영에서는 끈다
DEBUG=false
DEV_LOGIN=false

# 아래는 노트북 .env 그대로
YOUTUBE_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WATCH_ENABLED=true
LLM_DAILY_CAP=3000
